{
  "name": "convert2mermaid",
  "version": "2.1.0",
  "description": "Convert diagrams from other formats into mermaidJs syntax",
  "license": "MIT",
  "type": "module",
  "author": "Justin Greywolf <jgreywolf@lostware.com>",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npx tsc",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/cli.js",
    "dev": "npx tsx src/cli.ts",
    "analyze": "node scripts/analyze-diagram.js"
  },
  "bin": {
    "convert2mermaid": "./dist/cli.js"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "figlet": "^1.7.0",
    "ora": "^8.1.0",
    "vsdx-js": "^1.1.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/figlet": "^1.5.8",
    "@types/node": "^22.7.4",
    "@types/xml2js": "^0.4.14",
    "@vitest/coverage-v8": "^3.2.4",
    "vitest": "^3.1.3",
    "tsx": "^4.22.3",
    "typescript": "^5.6.2"
  }
}
